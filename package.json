{
  "name": "secki-mcp",
  "private": true,
  "type": "module",
  "description": "Public, read-only MCP server for Seçki İstanbul events (https://secki.istanbul/mcp), as a Cloudflare Pages Function.",
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "index": "tsx scripts/build-index.ts",
    "dev": "wrangler pages dev public --port 8791",
    "test": "vitest run",
    "typecheck": "tsc -p functions/tsconfig.json",
    "smoke": "bash scripts/mcp-smoke.sh http://localhost:8791"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^24.13.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "vitest": "5.0.4",
    "wrangler": "^4.156.0"
  }
}
